{
  "manifest_version": 3,
  "name": "Monday Contact Filler",
  "version": "1.3.4",
  "description": "Search Monday items by name and fill WhatsApp Web or Xero contact forms.",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": [
    "https://api.monday.com/*",
    "https://web.whatsapp.com/*",
    "https://*.xero.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://*.xero.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
